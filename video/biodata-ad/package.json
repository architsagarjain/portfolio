{
  "name": "biodata-ad",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "remotion studio --no-open",
    "render": "remotion render BiodataAd out/biodata-ad-9x16.mp4 --codec=h264 --crf=18 --concurrency=1",
    "render:sequence": "remotion render BiodataAd out/frames --sequence --image-format=jpeg --concurrency=1",
    "stitch": "ffmpeg -y -framerate 30 -i out/frames/element-%03d.jpeg -c:v libx264 -crf 18 -preset medium -threads 2 -pix_fmt yuv420p -movflags +faststart out/biodata-ad-9x16.mp4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.526",
    "@remotion/fonts": "4.0.526",
    "@remotion/google-fonts": "4.0.526",
    "@remotion/tailwind-v4": "4.0.526",
    "@remotion/transitions": "4.0.526",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.526",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "pngjs": "^7.0.0"
  }
}
